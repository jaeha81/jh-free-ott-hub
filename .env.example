# ========================================
# JH Free OTT Hub - Environment Variables
# ========================================
# 이 파일을 .env로 복사한 뒤 값을 채우세요
# cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/free_ott_hub
# 개발용 SQLite (PostgreSQL 없을 때):
# DATABASE_URL=sqlite+aiosqlite:///./free_ott_hub.db

# --- TMDb API ---
# https://developer.themoviedb.org 에서 API 키 발급
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Watchmode API (2단계 이후) ---
# https://api.watchmode.com 에서 발급
WATCHMODE_API_KEY=your_watchmode_api_key_here

# --- App Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
